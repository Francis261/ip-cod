[Unit]
Description=ipcod beacon (reports laptop public IP to coordinator)
After=network-online.target
Wants=network-online.target

# This is a systemd USER unit. Install with:
#   cp deploy/ipcod-beacon.service ~/.config/systemd/user/
#   cp deploy/beacon.env.example ~/.config/ipcod-beacon.env   # then edit
#   systemctl --user daemon-reload
#   systemctl --user enable --now ipcod-beacon
#   loginctl enable-linger $USER     # keep it running when logged out
#
# Note: EnvironmentFile paths below assume ~/.config/ipcod-beacon.env.

[Service]
Type=simple
EnvironmentFile=%h/.config/ipcod-beacon.env
ExecStart=/usr/local/bin/ipcod-beacon run
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
