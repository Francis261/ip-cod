[Unit]
Description=ipcod agent (VPS firewall sync)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/ipcod/agent.env
ExecStart=/usr/local/bin/ipcod-agent run
Restart=on-failure
RestartSec=3

# The agent MUST run as root because updating ufw requires privileges (it
# writes /etc/ufw/*.rules and manipulates netfilter). We keep root but harden
# the sandbox around it.
User=root

NoNewPrivileges=no
# ufw persists its rules under /etc/ufw, so that directory must stay
# writable. NOTE: on current systemd (255/Ubuntu 24.04) even
# ProtectSystem=full renders /etc read-only, which makes every `ufw
# allow`/`delete` fail with "'/etc/ufw/user.rules' is not writable" — so we
# carve out the exact path ufw needs instead of relying on full/strict
# semantics.
ProtectSystem=full
ReadWritePaths=/etc/ufw
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=no
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# The agent only makes outbound connections to the coordinator, plus the
# netlink socket ufw/iptables-nft needs to inspect and manage netfilter.
# Without AF_NETLINK, every `ufw status`/`allow`/`delete` fails with
# "Couldn't determine iptables version" (iptables-nft opens netlink even for
# version detection), so the agent could never apply a rule.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
# ufw needs to manage netfilter; allow the specific sysctls it touches.
ProtectKernelModules=no

[Install]
WantedBy=multi-user.target
