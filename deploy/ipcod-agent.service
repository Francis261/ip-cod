[Unit]
Description=ipcod agent (VPS firewall sync)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/ipcod/agent.env
ExecStart=/usr/local/bin/ipcod-agent run
Restart=on-failure
RestartSec=3

# The agent MUST run as root because updating ufw requires privileges (it
# writes /etc/ufw/*.rules and manipulates netfilter). We keep root but harden
# the sandbox around it.
User=root

NoNewPrivileges=no
# NOTE: ProtectSystem must stay "full", NOT "strict". "full" makes /usr and
# /boot read-only but leaves /etc writable, which ufw needs to persist rules
# to /etc/ufw/. Switching to "strict" makes the whole tree read-only and ufw
# allow/deny will silently fail to save rules across reloads.
ProtectSystem=full
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=no
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# The agent only makes outbound connections to the coordinator.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# ufw needs to manage netfilter; allow the specific sysctls it touches.
ProtectKernelModules=no

[Install]
WantedBy=multi-user.target
