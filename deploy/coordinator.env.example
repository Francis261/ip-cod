# ipcod coordinator configuration.
# Copy to /etc/ipcod/coordinator.env (root:root, mode 0600). Read by
# deploy/ipcod-coordinator.service.
#
# NOTE: variable names are prefixed with IPCOD_ and MUST match exactly.

# HTTP listen address. Behind a TLS-terminating reverse proxy or a Cloudflare
# tunnel, agents use wss:// and beacons use https:// on the public hostname.
IPCOD_LISTEN=:8443

# Admin bearer token guarding /api/admin/* and the dashboard login.
# Generate one with:  ipcod-coordinator gen-admin-token   (or: openssl rand -base64 32)
# WARNING: without this, the admin API is disabled (fail-closed).
IPCOD_ADMIN_TOKEN=

# Set to 1 when running behind a reverse proxy or Cloudflare tunnel so the
# coordinator trusts the leftmost X-Forwarded-For entry as the beacon's real
# source IP. REQUIRED behind Cloudflare, else every beacon is recorded as a
# Cloudflare edge IP and agents firewall-open the wrong address. Leave 0 if
# clients connect directly (prevents IP spoofing via a fake header).
IPCOD_TRUST_PROXY=0
