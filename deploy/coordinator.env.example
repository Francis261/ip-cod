# ipcod coordinator configuration.
# Copy to /etc/ipcod/coordinator.env (root:root, mode 0600). Read by
# deploy/ipcod-coordinator.service.
#
# NOTE: variable names are prefixed with IPCOD_ and MUST match exactly.

# HTTP listen address. Behind a TLS-terminating reverse proxy or a Cloudflare
# tunnel, agents use wss:// on the public hostname.
#
# Run modes (see README):
#   ipcod-coordinator run   headless (this unit's default)
#   ipcod-coordinator web   same, plus the dashboard UI (-p to pick a port)
IPCOD_LISTEN=:8443

# Admin bearer token guarding /api/admin/* and the dashboard login.
# Generate one with:  ipcod-coordinator gen-admin-token   (or: openssl rand -base64 32)
# WARNING: without this, the admin API is disabled (fail-closed).
IPCOD_ADMIN_TOKEN=

# Outbound public-IP detection — the coordinator asks echo services what its
# own address is, so no separate beacon process is needed.
# How often to re-check (default 60s).
IPCOD_DETECT_INTERVAL=60s
# Comma-separated echo URLs; leave empty for the built-in list
# (ipify, ifconfig.me, icanhazip, ipinfo, checkip.amazonaws.com).
IPCOD_IP_PROVIDERS=
# Set to 1 to switch detection off entirely (set the IP manually via the admin
# API, or rely on the legacy POST /api/beacon check-in endpoint).
IPCOD_NO_DETECT=0

# How often the coordinator re-pushes the current IP+ports to every connected
# agent. Agents verify their ufw rules against it and repair the difference,
# so this self-heals rules changed out-of-band. Default 30s; 0 disables.
IPCOD_RECONCILE_INTERVAL=30s

# Set to 1 when running behind a reverse proxy or Cloudflare tunnel so the
# coordinator trusts the leftmost X-Forwarded-For entry as a legacy beacon
# check-in's real source IP. Only relevant if you still use the old beacon
# endpoint; outbound detection does not use it. Leave 0 if clients connect
# directly (prevents IP spoofing via a fake header).
IPCOD_TRUST_PROXY=0
