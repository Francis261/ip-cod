# ipcod coordinator configuration.
# Copy to /etc/ipcod/coordinator.env and fill in. Read by systemd unit
# deploy/ipcod-coordinator.service.

# HTTP listen address. Put a TLS-terminating reverse proxy (Caddy/nginx) in
# front of this and point agents/beacons at wss:// / https://.
LISTEN=:8443

# Admin bearer token guarding /api/admin/* and the dashboard login.
# Generate one with:  openssl rand -base64 32
# WARNING: without this, the admin API is disabled (fail-closed).
ADMIN_TOKEN=

# Set to 1 when running behind a reverse proxy so the coordinator trusts the
# leftmost X-Forwarded-For entry as the beacon's real source IP. Leave 0 if
# clients connect directly (prevents IP spoofing via a fake header).
TRUST_PROXY=0
