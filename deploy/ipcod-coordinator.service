[Unit]
Description=ipcod coordinator (IP push server)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# All config comes from environment; see deploy/coordinator.env.example.
EnvironmentFile=/etc/ipcod/coordinator.env
ExecStart=/usr/local/bin/ipcod-coordinator run
Restart=on-failure
RestartSec=3

# Run as a dedicated unprivileged user. The coordinator binds a high port and
# needs write access only to its SQLite DB directory.
DynamicUser=yes
StateDirectory=ipcod
Environment=IPCOD_DB=/var/lib/ipcod/ipcod.db

# Hardening. The coordinator makes no outbound connections except SQLite file
# I/O, so we can lock the sandbox down tightly.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
# Agents connect inbound over TCP; beacons too.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# If you terminate TLS here (not behind a reverse proxy) and bind :443, drop
# CAP_NET_BIND_SERVICE into the bounding set. Prefer a reverse proxy for TLS.

[Install]
WantedBy=multi-user.target
