# ipcod agent configuration (runs on each VPS).
# Copy to /etc/ipcod/agent.env (root:root, mode 0600). Read by
# deploy/ipcod-agent.service.
#
# NOTE: variable names are prefixed with IPCOD_ and MUST match exactly; the
# binary reads IPCOD_COORDINATOR / IPCOD_TOKEN / etc. A bare COORDINATOR= here
# would be ignored and the agent would fail with "coordinator URL required".

# Coordinator WebSocket endpoint. Use wss:// in production (TLS).
IPCOD_COORDINATOR=wss://coord.example.com/ws

# Agent bearer token. This MUST be an ipca_ token (create the agent in the
# dashboard; the token is shown once). An ipcb_ beacon token will be rejected.
IPCOD_TOKEN=

# Optional display name for this agent in the dashboard.
IPCOD_NAME=

# Path to the ufw binary. Leave as-is unless ufw is in a nonstandard place.
IPCOD_UFW=ufw

# Set to 1 to log ufw commands instead of running them (safe testing).
IPCOD_DRY_RUN=0
