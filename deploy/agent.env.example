# ipcod agent configuration (runs on each VPS).
# Copy to /etc/ipcod/agent.env. Read by deploy/ipcod-agent.service.

# Coordinator WebSocket endpoint. Use wss:// in production (TLS).
COORDINATOR=wss://coord.example.com/ws

# Agent bearer token. Create the agent in the dashboard; the token is shown
# once. Generate the agent there, then paste its token here.
TOKEN=

# Optional display name; the coordinator's record for this token wins if set.
NAME=

# Path to the ufw binary. Leave as-is unless ufw is in a nonstandard place.
UFW_BIN=ufw

# Set to 1 to log ufw commands instead of running them (safe testing).
DRY_RUN=0
