# ipcod beacon configuration (runs on your laptop).
# The beacon is a user-level process; see deploy/ipcod-beacon.service for a
# systemd user unit, or run it manually / via your OS scheduler.

# Coordinator beacon endpoint. Use https:// in production.
COORDINATOR=https://coord.example.com/api/beacon

# Beacon bearer token. Create the beacon in the dashboard; token shown once.
TOKEN=

# Seconds between check-ins. 30 is a good default.
INTERVAL=30
