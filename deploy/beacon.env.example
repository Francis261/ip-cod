# ipcod beacon configuration (runs on your laptop).
# The beacon is a user-level process; see deploy/ipcod-beacon.service for a
# systemd user unit, or run it manually / via your OS scheduler.
# Copy to ~/.config/ipcod-beacon.env.
#
# NOTE: variable names are prefixed with IPCOD_ and MUST match exactly; a bare
# COORDINATOR= here would be ignored.

# Coordinator beacon endpoint. Use https:// in production.
IPCOD_COORDINATOR=https://coord.example.com/api/beacon

# Beacon bearer token (ipcb_ token from the dashboard; shown once at creation).
IPCOD_TOKEN=

# Check-in interval defaults to 30s. To change it, pass -interval on the
# ExecStart line of deploy/ipcod-beacon.service (e.g. -interval 60s); there is
# no environment variable for it.
